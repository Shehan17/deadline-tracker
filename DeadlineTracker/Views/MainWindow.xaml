<Window x:Class="DeadlineTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deadline Tracker"
        Height="650"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20"
                CornerRadius="8"
                BorderBrush="#DDD"
                BorderThickness="1"
                Margin="0,0,0,20">

            <DockPanel LastChildFill="False">
                <TextBlock Text="Deadline Tracker"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <Button Content="Add Deadline"
                        Height="38"
                        Width="150"
                        Command="{Binding AddDeadlineCommand}"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Deadlines}"
                 SelectedItem="{Binding SelectedDeadline}"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16"
                            Margin="0,0,0,12"
                            CornerRadius="8"
                            BorderBrush="#DDD"
                            BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <TextBlock FontSize="14"
                                           Margin="0,5,0,0">
                                    <Run Text="Category: "/>
                                    <Run Text="{Binding Category, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock FontSize="14">
                                    <Run Text="Deadline: "/>
                                    <Run Text="{Binding DeadlineAt, Mode=OneWay, StringFormat={}{0:MMM d yyyy h:mm tt}}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="14"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>

                                <TextBlock Text="{Binding RemainingTimeText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                                <TextBlock FontSize="14">
                                    <Run Text="Status: "/>
                                    <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="20,0,0,0">

                                <Button Width="100"
                                        Height="32"
                                        Margin="0,0,0,8"
                                        Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Complete"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Content" Value="Reopen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Delete"
                                        Width="100"
                                        Height="32"
                                        Command="{Binding DataContext.DeleteDeadlineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
