<Window x:Class="DeadlineTracker.Views.AddDeadlineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Deadline"
        Height="430"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add Deadline"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Title"/>
            <TextBox x:Name="TitleTextBox"
                     Height="34"
                     FontSize="15"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Category"/>
            <TextBox x:Name="CategoryTextBox"
                     Height="34"
                     FontSize="15"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Deadline Date"/>
                <DatePicker x:Name="DeadlineDatePicker"
                            Height="34"
                            FontSize="15"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Time"/>
                <TextBox x:Name="DeadlineTimeTextBox"
                         Height="34"
                         FontSize="15"
                         ToolTip="Example: 23:59"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Description"/>
            <TextBox x:Name="DescriptionTextBox"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     FontSize="15"/>
        </StackPanel>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="5"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="100"
                    Height="34"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>

            <Button Content="Add"
                    Width="100"
                    Height="34"
                    IsDefault="True"
                    Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
